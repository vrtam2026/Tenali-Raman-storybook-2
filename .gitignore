### Unity
# Unity generated directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Build output
*.apk
*.aab
*.unitypackage

# Autogenerated solution and project files
*.csproj
*.unityproj
*.sln
*.suo

### Windows
# Windows thumbnail cache files
Thumbs.db

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows shortcuts
*.lnk

### VisualStudio
# User-specific files
*.suo
*.user

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Bb]in/
[Oo]bj/

# Visual Studio cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
# The NuGet rule above accidentally also matches Unity's own Packages folder —
# these two files are Unity's package configuration and MUST be tracked, or
# every fresh clone loses all package references (this caused the original
# 149-error problem on clone).
!Packages/manifest.json
!Packages/packages-lock.json
!Packages/com.ptc.vuforia.engine-11.4.4.tgz
*.nuget.props
*.nuget.targets

# Publish Web Output
*.[Pp]ublish.xml

### VS Code
# VSCode settings (keep shared configuration)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# Unity CCD build cache — generated automatically, not source content
CCDBuildData/

# Local-only Unity CLI tools (per-machine, not shared)
# (must come after the "!/[Aa]ssets/**/*.meta" un-ignore above to actually exclude the .meta)
/Assets/Editor/LocalOnly/
/Assets/Editor/LocalOnly.meta

# Claude Code's own project settings (per-machine, personal — never shared)
.claude/settings.local.json